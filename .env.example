# EduAnalytics MVP — variáveis de ambiente
# NUNCA commite este arquivo com valores reais!
# Copie para .env e preencha: cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=edu_mvp
POSTGRES_USER=edu_user
POSTGRES_PASSWORD=TROQUE_PARA_SENHA_SEGURA_AQUI

# ── Aplicação ──────────────────────────────────────────────────────────────
EDU_DB_URL=postgresql://edu_user:TROQUE_PARA_SENHA_SEGURA_AQUI@localhost:5433/edu_mvp

# ── Ollama / LLM ───────────────────────────────────────────────────────────
EDU_OLLAMA_HOST=http://host.docker.internal:11434
EDU_DEFAULT_MODEL=mistral   # ver SupportedModel em contracts/data_models.py

# ── Logs & Debug ───────────────────────────────────────────────────────────
EDU_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# ── Streamlit ──────────────────────────────────────────────────────────────
# Não exponha publicamente no MVP local
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_PORT=8501
